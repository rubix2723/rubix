---
// RUBIX V2 — Footer Component (Closing Brand Signature)
// Conversational CTA, direct email action, quiet navigation, verified metadata, and monumental wordmark
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-hairline)] pt-12 md:pt-16 pb-12 transition-colors duration-200">
  <!-- Navigation Links & Practice Metadata -->
  <div class="pb-12 md:pb-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 items-start">
    <!-- Brand Context -->
    <div class="lg:col-span-5 flex flex-col gap-2">
      <a
        href="#hero-section"
        class="inline-flex items-center gap-1.5 select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm py-1 w-fit group"
        aria-label="RUBIX.studio - Back to top"
      >
        <span class="text-lg font-semibold tracking-tight text-[var(--text-primary)]">
          RUBIX<span class="text-[var(--text-tertiary)] font-normal group-hover:text-[var(--text-secondary)]">.studio</span>
        </span>
      </a>
      <span class="text-xs text-[var(--text-secondary)] font-sans max-w-[34ch]">
        Independent design and software engineering practice directed by Ruben.
      </span>
    </div>

    <!-- Quiet Navigation -->
    <div class="lg:col-span-4 flex flex-col gap-3">
      <span class="text-xs uppercase tracking-wider text-[var(--text-tertiary)] font-mono">
        Navigation
      </span>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-sans" aria-label="Footer navigation">
        <a
          href="#work"
          class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-150 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm"
        >
          Work
        </a>
        <a
          href="#studio"
          class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-150 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm"
        >
          Studio
        </a>
        <a
          href="#capabilities"
          class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-150 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm"
        >
          Capabilities
        </a>
        <a
          href="#process"
          class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-150 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm"
        >
          Process
        </a>
        <a
          href="#contact"
          class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-150 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm"
        >
          Contact
        </a>
      </nav>
    </div>

    <!-- Verified Practice Attributes -->
    <div class="lg:col-span-3 flex flex-col gap-2 text-xs text-[var(--text-tertiary)] font-mono">
      <span class="uppercase tracking-wider">Specifications</span>
      <span class="text-[var(--text-secondary)] font-sans">Direction: Ruben</span>
      <span class="text-[var(--text-secondary)] font-sans">Delivery: Direct Collaboration</span>
      <span class="text-[var(--text-secondary)] font-sans">Reach: Worldwide</span>
    </div>
  </div>

  <!-- Monumental Ranade Wordmark Watermark -->
  <div data-footer-wordmark class="w-full pt-6 pb-6 select-none pointer-events-none overflow-hidden" aria-hidden="true">
    <span class="block text-[clamp(2.75rem,11.5vw,9.5rem)] font-semibold tracking-[-0.04em] leading-none text-[var(--text-tertiary)]/20 uppercase transition-colors">
      RUBIX<span class="text-[var(--text-tertiary)]/12 font-normal">.studio</span>
    </span>
  </div>

  <!-- Bottom Utility Bar -->
  <div class="pt-6 border-t border-[var(--border-hairline)] flex items-center justify-between text-xs text-[var(--text-tertiary)] font-sans">
    <span>&copy; <span class="tabular-nums">{currentYear}</span> RUBIX.studio &middot; All rights reserved</span>
    <a
      id="back-to-top-btn"
      href="#hero-section"
      class="hover:text-[var(--text-primary)] transition-colors duration-150 inline-flex items-center gap-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-signal)] rounded-sm py-1"
      aria-label="Back to top of page"
    >
      <span>Back to top</span>
      <span aria-hidden="true">&uarr;</span>
    </a>
  </div>
</footer>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top-btn');
    if (btn) {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }
  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
