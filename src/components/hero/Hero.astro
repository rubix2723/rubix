---
interface Props {
  weight?: 500 | 600;
}

const { weight = 500 } = Astro.props;
---

<section
  id="hero-section"
  data-hero-container
  class="relative min-h-[100svh] w-full flex flex-col justify-between items-center text-center px-4 sm:px-6 md:px-8 pt-24 sm:pt-28 md:pt-32 lg:pt-36 pb-12 sm:pb-16 md:pb-20 overflow-hidden bg-[#07080A]"
>
  <!-- Edge-to-Edge Full-Bleed Background Video Layer (Native Composited, Zero Box, Zero WebGL) -->
  <div
    data-hero-video-wrap
    class="hero-video-container absolute inset-0 w-full h-full pointer-events-none select-none z-0 overflow-hidden"
  >
    <video
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      poster="/media/hero/rubix-cinematic-poster.webp"
      preload="auto"
      class="hero-video-element absolute inset-0 w-full h-full object-cover object-[50%_45%] sm:object-center pointer-events-none select-none"
      aria-hidden="true"
    >
      <source src="/media/hero/rubix-cinematic.webm" type="video/webm" />
      <source src="/media/hero/rubix-cinematic.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Text-Protection Atmospheric Veils (Frameless, Zero-Box, Edge-to-Edge) -->
  <div
    class="hero-protection-veil absolute inset-0 pointer-events-none select-none z-[1]"
    aria-hidden="true"
  ></div>

  <!-- Top Clearance Anchor (Under Floating Glass Capsule) -->
  <div class="w-full h-3 sm:h-6 shrink-0 relative z-10" aria-hidden="true"></div>

  <!-- Centered Hero Composition: Primary Statement, Supporting Copy & Decisive Action -->
  <div
    data-hero-content
    class="relative z-10 flex flex-col items-center justify-center my-auto w-full max-w-[1240px] px-4"
  >
    <!-- Primary Display Triad (Ranade 500, Optically Centered) -->
    <h1
      class="hero-display text-center select-none"
      style={`--hero-weight: ${weight};`}
    >
      <span data-hero-line="1" class="hero-line hero-line-1 block text-[#F4F4F6]">Design.</span>
      <span data-hero-line="2" class="hero-line hero-line-2 block text-[#F4F4F6]">Development.</span>
      <span data-hero-line="3" class="hero-line hero-line-3 block text-[#A0A5B5]">Knowledge.</span>
    </h1>

    <!-- Factual Supporting Copy (Single Centered Column, Balanced Measure) -->
    <div
      data-hero-support
      class="hero-support-block mt-7 sm:mt-9 md:mt-11 max-w-[620px] mx-auto text-center px-4"
    >
      <p class="hero-supporting text-base sm:text-lg md:text-xl text-[#E2E4EB] leading-[1.6] text-pretty font-normal">
        RUBIX designs and builds digital products—from identity and interface to the software behind them.
      </p>
      <p class="hero-supporting-sub text-sm sm:text-base text-[#9FA4B4] mt-2.5 sm:mt-3 text-pretty font-normal">
        Work directly with the person designing and building it.
      </p>
    </div>

    <!-- Single Decisive Primary Action (Centered, RUBIX Signal Orange Hover) -->
    <div
      data-hero-action
      class="hero-action-block mt-8 sm:mt-10 md:mt-12 flex justify-center items-center"
    >
      <a
        data-hero-cta
        href="#work"
        class="hero-cta group inline-flex items-center justify-center gap-2.5 px-7 py-3.5 min-h-[48px] rounded-lg bg-[#F4F4F6] text-[#07080A] font-medium text-sm transition-all duration-200 hover:bg-[var(--accent-signal)] hover:text-white active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--accent-signal)] select-none shadow-[0_4px_24px_rgba(0,0,0,0.35)]"
      >
        <span>View selected work</span>
        <svg
          class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:translate-y-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 4.5 15 15m0 0V8.25m0 11.25H8.25" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom Balance Spacer -->
  <div class="w-full h-3 sm:h-6 shrink-0 relative z-10" aria-hidden="true"></div>
</section>

<style>
  .hero-protection-veil {
    background:
      radial-gradient(ellipse 70% 55% at 50% 48%, rgba(7, 8, 10, 0.48) 0%, rgba(7, 8, 10, 0.24) 55%, transparent 85%),
      linear-gradient(to bottom, rgba(7, 8, 10, 0.38) 0%, rgba(7, 8, 10, 0.20) 40%, rgba(7, 8, 10, 0.72) 100%);
  }

  .hero-display {
    font-size: clamp(2.4rem, 1.1rem + 5.2vw, 7.25rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: var(--hero-weight, 500);
    font-family: var(--font-brand);
  }

  .hero-line {
    white-space: nowrap;
    overflow-wrap: normal;
  }

  /* Short laptop viewports: scale typography gracefully so CTA never clips */
  @media (max-height: 760px) and (min-width: 1024px) {
    .hero-display {
      font-size: clamp(2.3rem, 1rem + 4.2vw, 5.25rem);
      line-height: 0.95;
    }
    .hero-support-block {
      margin-top: 1.5rem !important;
    }
    .hero-action-block {
      margin-top: 1.5rem !important;
    }
  }

  @media (max-height: 660px) and (min-width: 1024px) {
    .hero-display {
      font-size: clamp(2.1rem, 0.9rem + 3.6vw, 4.4rem);
    }
    .hero-support-block {
      margin-top: 1.25rem !important;
    }
    .hero-action-block {
      margin-top: 1.25rem !important;
    }
  }

  /* Emil Kowalski Entrance Sequence (< 450ms total, subtle 12px rise) */
  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-line-1 {
    animation: heroRise 320ms cubic-bezier(0.23, 1, 0.32, 1) 40ms both;
  }

  .hero-line-2 {
    animation: heroRise 320ms cubic-bezier(0.23, 1, 0.32, 1) 100ms both;
  }

  .hero-line-3 {
    animation: heroRise 320ms cubic-bezier(0.23, 1, 0.32, 1) 160ms both;
  }

  .hero-supporting {
    animation: heroRise 280ms cubic-bezier(0.23, 1, 0.32, 1) 220ms both;
  }

  .hero-supporting-sub {
    animation: heroRise 280ms cubic-bezier(0.23, 1, 0.32, 1) 260ms both;
  }

  .hero-cta {
    animation: heroRise 280ms cubic-bezier(0.23, 1, 0.32, 1) 300ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-1,
    .hero-line-2,
    .hero-line-3,
    .hero-supporting,
    .hero-supporting-sub,
    .hero-cta {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const section = document.querySelector<HTMLElement>('#hero-section');
    if (!video || !section) return;

    const heroVid: HTMLVideoElement = video;
    const heroSec: HTMLElement = section;

    // 1. Reduced Motion Preference
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    function handleMotionPreference(e: MediaQueryList | MediaQueryListEvent) {
      if (e.matches) {
        heroVid.pause();
        heroVid.currentTime = 1.0;
      } else {
        heroVid.play().catch(() => {});
      }
    }
    mediaQuery.addEventListener('change', handleMotionPreference);
    if (mediaQuery.matches) {
      heroVid.pause();
      heroVid.currentTime = 1.0;
    }

    // 2. IntersectionObserver to pause offscreen
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!mediaQuery.matches) {
              if (entry.isIntersecting) {
                heroVid.play().catch(() => {});
              } else {
                heroVid.pause();
              }
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(heroSec);
    }

    // 3. Document visibility optimization
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        heroVid.pause();
      } else if (!mediaQuery.matches && heroSec.getBoundingClientRect().bottom > 0) {
        heroVid.play().catch(() => {});
      }
    });

    // 4. Initial play attempt with graceful autoplay fallback
    if (!mediaQuery.matches) {
      heroVid.play().catch(() => {
        // Autoplay policy prevented playback, poster frame remains visible cleanly
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroVideo);
  } else {
    setupHeroVideo();
  }
  document.addEventListener('astro:page-load', setupHeroVideo);
</script>
