---
import { LiquidSilkGradient } from '../ui/liquid-silk-gradient';

interface Props {
  weight?: 500 | 600;
}

const { weight = 500 } = Astro.props;
---

<section id="hero-section" data-hero-container class="relative min-h-[84svh] md:min-h-[86svh] flex flex-col justify-between pt-28 sm:pt-32 md:pt-36 lg:pt-40 pb-16 md:pb-24">
  <!-- Volumetric Liquid Silk Gradient (Zero Bounding Box, Full Bleed, Pure Alpha Transparency) -->
  <div
    data-hero-silk-wrap
    class="absolute -top-12 md:-top-16 -bottom-16 md:-bottom-24 left-1/2 -translate-x-1/2 w-screen pointer-events-none select-none overflow-hidden -z-10"
  >
    <div
      data-hero-silk
      data-hero-mercury
      class="w-full h-full"
    >
      <LiquidSilkGradient
        client:load
        interactive={true}
        speed={0.42}
        canvasOpacity={0.92}
        transparentBackground={true}
        focalOffset={[0.16, 0.0]}
      />
    </div>
  </div>

  <!-- Top Spread: Primary Display Triad (Cols 1-8) & Studio Metadata (Cols 9-12) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-8">
      <h1
        class="hero-display"
        style={`--hero-weight: ${weight};`}
      >
        <span data-hero-line="1" class="hero-line hero-line-1 block text-[var(--text-primary)] origin-left">Design.</span>
        <span data-hero-line="2" class="hero-line hero-line-2 block text-[var(--text-primary)] origin-left">Development.</span>
        <span data-hero-line="3" class="hero-line hero-line-3 block text-[var(--text-tertiary)] origin-left">Knowledge.</span>
      </h1>
    </div>

    <!-- Quiet Studio Metadata (Desktop Asymmetric Anchor) -->
    <div data-hero-meta class="hidden lg:flex lg:col-span-4 flex-col gap-5 pt-3 pl-8 border-l border-[var(--border-hairline)] select-none">
      <div>
        <span class="text-xs font-mono text-[var(--text-tertiary)] uppercase tracking-wider block">Practice</span>
        <p class="text-sm text-[var(--text-secondary)] mt-0.5">Digital Products & Software Systems</p>
      </div>
      <div>
        <span class="text-xs font-mono text-[var(--text-tertiary)] uppercase tracking-wider block">Location</span>
        <p class="text-sm text-[var(--text-secondary)] mt-0.5">Independent Studio</p>
      </div>
    </div>
  </div>

  <!-- Bottom Spread: Supporting Copy & Decisive Action -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end pt-12 md:pt-16">
    <div data-hero-support class="lg:col-span-8 max-w-[54ch]">
      <p class="hero-supporting text-base sm:text-lg md:text-xl text-[var(--text-secondary)] leading-[1.6] text-pretty">
        RUBIX designs and builds digital products—from identity and interface to the software behind them.
      </p>
      <p class="hero-supporting-sub text-sm sm:text-base text-[var(--text-tertiary)] mt-3 text-pretty">
        Work directly with the person designing and building it.
      </p>
    </div>

    <!-- Single Decisive Primary Action -->
    <div class="lg:col-span-4 lg:flex lg:justify-end">
      <a
        data-hero-cta
        href="#work"
        class="hero-cta inline-flex items-center justify-center gap-2.5 px-6 py-3 min-h-[44px] rounded-lg bg-[var(--text-primary)] text-[var(--bg-canvas)] font-medium text-sm transition-all duration-150 hover:opacity-90 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--accent-signal)] select-none group"
      >
        <span>View selected work</span>
        <svg
          class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:translate-y-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 4.5 15 15m0 0V8.25m0 11.25H8.25" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-display {
    font-size: clamp(2.4rem, 1.1rem + 5.4vw, 7.5rem);
    line-height: 0.93;
    letter-spacing: -0.04em;
    font-weight: var(--hero-weight, 500);
  }

  .hero-line {
    white-space: nowrap;
    overflow-wrap: normal;
  }

  /* Emil Kowalski Entrance Sequence (< 450ms total, subtle 10px rise) */
  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-line-1 {
    animation: heroRise 300ms cubic-bezier(0.23, 1, 0.32, 1) 30ms both;
  }

  .hero-line-2 {
    animation: heroRise 300ms cubic-bezier(0.23, 1, 0.32, 1) 90ms both;
  }

  .hero-line-3 {
    animation: heroRise 300ms cubic-bezier(0.23, 1, 0.32, 1) 150ms both;
  }

  .hero-supporting {
    animation: heroRise 260ms cubic-bezier(0.23, 1, 0.32, 1) 200ms both;
  }

  .hero-supporting-sub {
    animation: heroRise 260ms cubic-bezier(0.23, 1, 0.32, 1) 240ms both;
  }

  .hero-cta {
    animation: heroRise 260ms cubic-bezier(0.23, 1, 0.32, 1) 280ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-1,
    .hero-line-2,
    .hero-line-3,
    .hero-supporting,
    .hero-supporting-sub,
    .hero-cta {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
