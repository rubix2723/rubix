---
interface ProjectItem {
  index: string;
  title: string;
  category: string;
  contribution: string;
  year: string;
  description: string;
  shortDescription?: string;
  liveUrl: string;
  imageSrc: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
}

interface Props {
  projectA: ProjectItem;
  projectB: ProjectItem;
}

const { projectA, projectB } = Astro.props;
---

<!-- Pair Container with Subtle Editorial Stagger & Rhythm -->
<div class="project-pair grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 lg:gap-14 items-start">
  <!-- Project A: Pastel Booth Co. (Airy, higher anchor) -->
  <article data-project="04" data-pair-item="a" class="group mb-14 md:mb-0">
    <a
      href={projectA.liveUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-signal)] rounded-lg"
      aria-label={`Visit live website for ${projectA.title} (opens in a new tab)`}
    >
      <div data-pair-media class="relative w-full rounded-lg overflow-hidden border border-[var(--border-hairline)] group-hover:border-[var(--border-strong)] transition-colors duration-200 bg-[var(--bg-surface)]">
        <img
          data-pair-img
          src={projectA.imageSrc}
          alt={projectA.imageAlt}
          width={projectA.imageWidth}
          height={projectA.imageHeight}
          loading="lazy"
          decoding="async"
          class="w-full h-auto block object-contain transition-transform duration-200 ease-out group-hover:scale-[1.01]"
          style={`aspect-ratio: ${projectA.imageWidth} / ${projectA.imageHeight};`}
        />
      </div>

      <div class="mt-5">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono tabular-nums text-[var(--text-tertiary)]">{projectA.index}</span>
          <span class="text-xs text-[var(--text-tertiary)]">·</span>
          <span class="text-xs font-sans text-[var(--text-secondary)]">{projectA.category}</span>
        </div>

        <h3 class="text-lg sm:text-xl md:text-2xl font-medium tracking-tight text-[var(--text-primary)] mt-2 group-hover:text-[var(--accent-signal)] transition-colors duration-150 text-balance">
          {projectA.title}
        </h3>

        <!-- Full description on desktop, brief descriptor on mobile -->
        <p class="text-sm text-[var(--text-secondary)] leading-[1.6] mt-2 max-w-[42ch] hidden sm:block text-pretty">
          {projectA.description}
        </p>
        <p class="text-sm text-[var(--text-secondary)] leading-[1.6] mt-1.5 block sm:hidden text-pretty">
          {projectA.shortDescription || projectA.description}
        </p>

        <div class="mt-4 pt-4 border-t border-[var(--border-hairline)] flex items-center justify-between gap-4">
          <span class="text-xs font-sans text-[var(--text-tertiary)]">{projectA.contribution} · <span class="font-mono tabular-nums">{projectA.year}</span></span>
          <span class="inline-flex items-center gap-1.5 min-h-[44px] py-1 text-xs sm:text-sm font-medium text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors shrink-0">
            <span>Visit live site</span>
            <svg class="size-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </article>

  <!-- Project B: M.M. Engineering Works (Subtle vertical offset on desktop) -->
  <article data-project="05" data-pair-item="b" class="group md:mt-12 lg:mt-16">
    <a
      href={projectB.liveUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-signal)] rounded-lg"
      aria-label={`Visit live website for ${projectB.title} (opens in a new tab)`}
    >
      <div data-pair-media class="relative w-full rounded-lg overflow-hidden border border-[var(--border-hairline)] group-hover:border-[var(--border-strong)] transition-colors duration-200 bg-[var(--bg-surface)]">
        <img
          data-pair-img
          src={projectB.imageSrc}
          alt={projectB.imageAlt}
          width={projectB.imageWidth}
          height={projectB.imageHeight}
          loading="lazy"
          decoding="async"
          class="w-full h-auto block object-contain transition-transform duration-200 ease-out group-hover:scale-[1.01]"
          style={`aspect-ratio: ${projectB.imageWidth} / ${projectB.imageHeight};`}
        />
      </div>

      <div class="mt-6">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono tabular-nums text-[var(--text-tertiary)]">{projectB.index}</span>
          <span class="text-xs text-[var(--text-tertiary)]">·</span>
          <span class="text-xs font-sans text-[var(--text-secondary)]">{projectB.category}</span>
        </div>

        <h3 class="text-lg sm:text-xl md:text-2xl font-medium tracking-tight text-[var(--text-primary)] mt-2 group-hover:text-[var(--accent-signal)] transition-colors duration-150 text-balance">
          {projectB.title}
        </h3>

        <!-- Full description on desktop, brief descriptor on mobile -->
        <p class="text-sm text-[var(--text-secondary)] leading-[1.6] mt-2 max-w-[36ch] hidden sm:block text-pretty">
          {projectB.description}
        </p>
        <p class="text-sm text-[var(--text-secondary)] leading-[1.6] mt-1.5 block sm:hidden text-pretty">
          {projectB.shortDescription || projectB.description}
        </p>

        <div class="mt-4 pt-4 border-t border-[var(--border-hairline)] flex items-center justify-between gap-4">
          <span class="text-xs font-sans text-[var(--text-tertiary)]">{projectB.contribution} · <span class="font-mono tabular-nums">{projectB.year}</span></span>
          <span class="inline-flex items-center gap-1.5 min-h-[44px] py-1 text-xs sm:text-sm font-medium text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors shrink-0">
            <span>Visit live site</span>
            <svg class="size-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </article>
</div>
