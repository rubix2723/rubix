---
interface Props {
  index: string;
  title: string;
  category: string;
  contribution: string;
  year: string;
  description: string;
  shortDescription?: string;
  liveUrl: string;
  imageSrc: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  reversed?: boolean;
}

const {
  index,
  title,
  category,
  contribution,
  year,
  description,
  shortDescription,
  liveUrl,
  imageSrc,
  imageAlt,
  imageWidth,
  imageHeight,
  reversed = false,
} = Astro.props;
---

<article data-project={index} class="project-split group">
  <a
    href={liveUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-signal)] rounded-lg"
    aria-label={`Visit live website for ${title} (opens in a new tab)`}
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Media Column -->
      <div data-split-media class:list={[
        "lg:col-span-7",
        reversed ? "order-1 lg:order-2" : "order-1"
      ]}>
        <div class="relative w-full rounded-lg overflow-hidden border border-[var(--border-hairline)] group-hover:border-[var(--border-strong)] transition-colors duration-200 bg-[var(--bg-surface)]">
          <img
            data-split-img
            src={imageSrc}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            loading="lazy"
            decoding="async"
            class="w-full h-auto block object-contain transition-transform duration-200 ease-out group-hover:scale-[1.01]"
            style={`aspect-ratio: ${imageWidth} / ${imageHeight};`}
          />
        </div>
      </div>

      <!-- Narrative & Metadata Column -->
      <div data-split-text class:list={[
        "lg:col-span-5 flex flex-col justify-center",
        reversed ? "order-2 lg:order-1" : "order-2"
      ]}>
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono tabular-nums text-[var(--text-tertiary)]">{index}</span>
          <span class="text-xs text-[var(--text-tertiary)]">·</span>
          <span class="text-xs font-sans text-[var(--text-secondary)]">{category}</span>
        </div>

        <h3 class="text-xl sm:text-2xl lg:text-3xl font-medium tracking-tight text-[var(--text-primary)] mt-2 group-hover:text-[var(--accent-signal)] transition-colors duration-150 text-balance">
          {title}
        </h3>

        <!-- Full description on desktop, concise factual statement on mobile -->
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-[1.6] mt-3 max-w-[44ch] hidden sm:block text-pretty">
          {description}
        </p>
        <p class="text-sm text-[var(--text-secondary)] leading-[1.6] mt-2.5 block sm:hidden text-pretty">
          {shortDescription || description}
        </p>

        <div class="mt-6 pt-5 border-t border-[var(--border-hairline)] flex items-center justify-between gap-4">
          <div>
            <span class="text-xs font-sans text-[var(--text-tertiary)] block">Role</span>
            <p class="text-xs sm:text-sm font-sans text-[var(--text-secondary)] mt-0.5">{contribution} · <span class="font-mono tabular-nums">{year}</span></p>
          </div>

          <!-- Quieter Editorial Link with 44px min hit area -->
          <span class="inline-flex items-center gap-1.5 min-h-[44px] py-1 text-xs sm:text-sm font-medium text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors shrink-0">
            <span>Visit live site</span>
            <svg
              class="size-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </a>
</article>
