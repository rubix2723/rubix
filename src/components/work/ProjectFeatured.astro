---
interface Props {
  index: string;
  title: string;
  category: string;
  contribution: string;
  year: string;
  description: string;
  shortDescription?: string;
  liveUrl: string;
  imageSrc: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
}

const {
  index,
  title,
  category,
  contribution,
  year,
  description,
  liveUrl,
  imageSrc,
  imageAlt,
  imageWidth,
  imageHeight,
} = Astro.props;
---

<article data-project="01" class="project-featured group">
  <a
    href={liveUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-signal)] rounded-lg"
    aria-label={`Visit live website for ${title} (opens in a new tab)`}
  >
    <!-- Media Container with Native Aspect Ratio, Hairline Border & Background Surface -->
    <div data-project-media class="relative w-full rounded-lg overflow-hidden border border-[var(--border-hairline)] group-hover:border-[var(--border-strong)] transition-colors duration-200 bg-[var(--bg-surface)]">
      <img
        data-project-img
        src={imageSrc}
        alt={imageAlt}
        width={imageWidth}
        height={imageHeight}
        loading="lazy"
        decoding="async"
        class="w-full h-auto block object-contain transition-transform duration-200 ease-out group-hover:scale-[1.01]"
        style={`aspect-ratio: ${imageWidth} / ${imageHeight};`}
      />
    </div>

    <!-- Editorial Context & Metadata Spread -->
    <div data-project-meta class="mt-6 md:mt-8 pt-6 border-t border-[var(--border-hairline)] grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-8">
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-mono tabular-nums text-[var(--text-tertiary)]">{index}</span>
          <span class="text-xs text-[var(--text-tertiary)]">·</span>
          <span class="text-xs font-sans text-[var(--text-secondary)]">Featured</span>
        </div>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight text-[var(--text-primary)] mt-2 group-hover:text-[var(--accent-signal)] transition-colors duration-150 text-balance">
          {title}
        </h3>
        <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-[1.6] mt-3 max-w-[56ch] text-pretty">
          {description}
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col justify-between gap-5 self-stretch lg:pl-8 lg:border-l lg:border-[var(--border-hairline)]">
        <div class="grid grid-cols-2 lg:grid-cols-1 gap-4">
          <div>
            <span class="text-xs font-sans text-[var(--text-tertiary)] block">Category</span>
            <p class="text-sm font-sans text-[var(--text-secondary)] mt-0.5">{category}</p>
          </div>
          <div>
            <span class="text-xs font-sans text-[var(--text-tertiary)] block">Contribution</span>
            <p class="text-sm font-sans text-[var(--text-secondary)] mt-0.5">{contribution}</p>
          </div>
          <div>
            <span class="text-xs font-sans text-[var(--text-tertiary)] block">Year</span>
            <p class="text-sm font-mono tabular-nums text-[var(--text-secondary)] mt-0.5">{year}</p>
          </div>
        </div>

        <!-- Tier 1 Prominent Visible Action Link -->
        <div class="pt-2">
          <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-[var(--bg-surface)] border border-[var(--border-hairline)] text-sm font-medium text-[var(--text-primary)] group-hover:border-[var(--border-strong)] group-hover:text-[var(--accent-signal)] transition-all duration-200">
            <span>Visit live site</span>
            <svg
              class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </a>
</article>
